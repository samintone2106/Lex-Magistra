# Copiar a .env.local y completar. .env.local está en .gitignore.

# Supabase (Project Settings → API). La anon key es pública; la seguridad la da RLS.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL pública del sitio (correos de confirmación, SEO, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SOLO para scripts locales (npm run make-admin). Nunca en Vercel como variable pública ni en el cliente.
SUPABASE_SERVICE_ROLE_KEY=

# Solo desarrollo local: barra para cambiar entre cuentas de prueba (admin/abogado/cliente @example.com).
# Nunca se activa en producción ni contra un Supabase remoto.
DEMO_SWITCHER=
DEMO_PASSWORD=
